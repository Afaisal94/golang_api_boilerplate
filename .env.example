# Contoh konfigurasi - copy ke .env dan sesuaikan

# development atau production (production = gin release mode + DB wajib SSL)
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db_go_api
DB_SSLMODE=disable
APP_PORT=3000
APP_NAME=First App

# Redis (cache / session / rate limit)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT secret — WAJIB minimal 32 karakter, jangan pakai default!
JWT_SECRET=change-this-to-a-random-32-char-string
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Brevo HTTP API untuk OTP verifikasi email
# SMTP_FROM WAJIB sender yang sudah diverifikasi di Brevo (Settings > Senders & IP)
SMTP_FROM=noreply@hellofaisal.my.id

# API key Brevo (SMTP & API > API Keys, format xkeysib-...) — WAJIB diisi
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# OTP verifikasi email
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5

# Nama lama (tetap didukung, prioritas ke DB_* jika keduanya ada):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=db_go_api
